{
  "name": "dennexequiel-skills",
  "description": "Agent skills that come with receipts.",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "author": "Denn Exequiel",
  "license": "MIT",
  "homepage": "https://github.com/dennexequiel/skills#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennexequiel/skills.git"
  },
  "bugs": {
    "url": "https://github.com/dennexequiel/skills/issues"
  },
  "keywords": [
    "agent-skills",
    "coding-agents",
    "opencode"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "bun run typecheck && bun run check:skills && bun run check:routing && bun run check:catalog && bun test",
    "check:catalog": "bun scripts/generate-catalog.ts",
    "check:routing": "bun scripts/check-routing.ts",
    "check:skills": "bun scripts/check-skills.ts",
    "generate:catalog": "bun scripts/generate-catalog.ts --write",
    "install:opencode": "bun scripts/install-opencode.ts",
    "release:version": "bun scripts/release-version.ts",
    "smoke:agy": "bun scripts/smoke-agy.ts",
    "smoke:claude-code": "bun scripts/smoke-claude-code.ts",
    "smoke:opencode": "bun scripts/smoke-opencode.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.5",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
